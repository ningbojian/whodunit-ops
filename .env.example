# 复制本文件为 .env，然后填入真实值。
# .env 已在 .gitignore 中，不会被提交。不要把真实 key 写进本文件或贴进聊天。

# ---------------------------------------------------------------------------
# DeepSeek（命令行版与网页版共用）
# ---------------------------------------------------------------------------
# 申请地址：https://platform.deepseek.com/api_keys
# 生产环境（WEB_ENV=production）必填；缺失时启动直接失败。
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# 网页版
# ---------------------------------------------------------------------------
# development / production
WEB_ENV=development

# 必填。会话签名密钥，至少 32 字符。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SESSION_SECRET=

# 必填。审批邮件的收件人（开发者邮箱）。
# 使用 Resend 测试发件人 onboarding@resend.dev 时，这里必须是 Resend 账号注册邮箱。
OWNER_EMAIL=

# console：本地开发，审批链接打印在服务端控制台，不联网
# resend：生产环境，通过 Resend HTTPS API 发信
EMAIL_BACKEND=console

# EMAIL_BACKEND=resend 时必填
RESEND_API_KEY=

# 当前审批邮件只发给 OWNER_EMAIL，所以没有自有域名也可以用
# onboarding@resend.dev；但它只能发给 Resend 账号注册邮箱。
# 以后需要发给其他地址时，先在 Resend 验证域名并改成自己的发件地址。
EMAIL_FROM=onboarding@resend.dev

# 公网地址，用于生成审批链接和备用链接；生产环境必须是 https://
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# excel：本地 CLI / 旧演示，数据写 data/*.xlsx 与 data/web_state.sqlite3
# database：Web 使用 SQLite（本地）或 Neon Postgres（生产）
# 生产环境不设置时默认 database，且必须提供 DATABASE_URL。
# 生产环境显式设为 excel 会启动失败：容器磁盘是临时的，重启会丢数据。
WEB_STORAGE_BACKEND=excel

# Neon 连接串（生产必填）。不要提交到仓库或贴进聊天。
# 应用运行时用池化地址（主机名带 -pooler），适合 PgBouncer 事务模式。
# 控制台复制 postgresql://...，应用会自动改用 psycopg 3 驱动。
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 迁移/建表/导出优先使用直连地址（主机名不带 -pooler）。
# 没有这一项时 migrate 会回退到 DATABASE_URL。
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 本地 database 模式且没有 DATABASE_URL 时使用这个 SQLite 文件。
WEB_DATABASE_SQLITE_PATH=data/web.sqlite3

# 旧 Excel 模式的路径；database 模式下业务数据不写这里。
# 仍用于导入/导出和旧数据兼容。
WEB_DATA_ROOT=data/web_users
WEB_STATE_DB=data/web_state.sqlite3

# 可选连接池参数
# DATABASE_POOL_SIZE=3
# DATABASE_MAX_OVERFLOW=2
# DATABASE_POOL_TIMEOUT=10

# 默认门店名（演示数据与 Agent 提示词使用）
WEB_DEFAULT_STORE=迷雾剧场

# ---------------------------------------------------------------------------
# 可选安全上限（不填使用默认值，详见 README）
# ---------------------------------------------------------------------------
# WEB_ACCESS_HOURS=8
# WEB_APPROVAL_TTL_HOURS=24
# WEB_SESSION_HOURS=24
# WEB_MAX_INPUT_CHARS=2000
# WEB_MAX_BODY_BYTES=32768
# WEB_MAX_HISTORY_MESSAGES=100
# WEB_MAX_HISTORY_CHARS=50000
# WEB_MAX_CONCURRENT_TURNS=3
# WEB_MAX_TURNS_GLOBAL_PER_DAY=300
# WEB_MODEL_MAX_TOKENS=1500
# WEB_MODEL_TIMEOUT_SECONDS=60
# WEB_REQUEST_COOLDOWN_MINUTES=10
# WEB_REQUESTS_PER_IP_PER_HOUR=5
# WEB_REQUESTS_GLOBAL_PER_DAY=50

# ---------------------------------------------------------------------------
# 导入、DM 场控与硬件增值模式
# ---------------------------------------------------------------------------
# 渠道单上传上限；普通请求仍受 WEB_MAX_BODY_BYTES 限制。
# 范围 32768..10485760。
# WEB_MAX_IMPORT_BYTES=2097152

# 场控码有效期（分钟，5..120）与 DM token 有效期（小时，1..24）。
# DM_CODE_TTL_MINUTES=30
# DM_TOKEN_HOURS=12

# 硬件 Skill 地址与 token 只放服务端；为空时硬件模式不可用，软件模式不受影响。
# 生产环境只接受 https://，本地开发允许 http://127.0.0.1。
# HARDWARE_SKILL_URL=
# HARDWARE_SKILL_TOKEN=
# HARDWARE_TIMEOUT_SECONDS=2

# ---------------------------------------------------------------------------
# 联网搜索（web_search 工具，可选）
# ---------------------------------------------------------------------------
# 未设置 WEB_SEARCH_API_KEY 时工具返回 not_configured，不产生任何费用。
# 申请地址：https://app.tavily.com （Free 档 1,000 credits/月，无需绑卡）。
# key 只放本地 .env 或 Render Secret，不要提交到仓库或贴进聊天。
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# 多租户日配额（0 = 不限）。默认 10/商家/日、30/全站/日（≈900/月），
# 结构性低于 Tavily 免费档 1,000 credits/月，默认配置不会触发付费。
# 范围夹取：租户 0–100，全局 0–500。
# WEB_SEARCH_TENANT_DAILY_LIMIT=10
# WEB_SEARCH_GLOBAL_DAILY_LIMIT=30
